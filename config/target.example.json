  "language": {
    "uiLanguages": ["en", "ar"],
    "testRtl": true
  },
  "browser": {
    "name": "chromium",
    "viewport": { "width": 1920, "height": 1080 }
  },
  "safety": {
    "environment": "staging",
    "allowCreate": true,
    "allowEdit": true,
    "allowDelete": "only-own-records",
    "dataPrefix": "QA-AUTO-"
  }
