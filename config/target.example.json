  "appSlug": "pm-portal",
  "baseUrl": "https://app.example.com",
  "loginPath": "/login",
  "credentials": [
    {
      "role": "Project Manager",
      "username": "pm.user@example.com",
      "password": "PUT-PASSWORD-HERE",
      "primary": true
    },
    {
      "role": "Team Member",
      "username": "member@example.com",
      "password": "PUT-PASSWORD-HERE",
      "primary": false
    }
